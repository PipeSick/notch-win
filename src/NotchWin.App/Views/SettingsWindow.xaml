<Window
    x:Class="NotchWin.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="16" MaxWidth="480">
            <TextBlock Text="NotchWin — Ajustes" FontSize="20" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <CheckBox x:Name="NotchModuleCheckBox" Content="Notch overlay" />
                <CheckBox x:Name="MusicModuleCheckBox" Content="Módulo de música" />
                <CheckBox x:Name="AiAgentsModuleCheckBox" Content="Monitor de agentes de IA" />
                <CheckBox x:Name="LyricsCheckBox" Content="Letras sincronizadas (envía título y artista a NetEase Music)" />
                <CheckBox x:Name="LyricsInPillCheckBox" Content="Mostrar la letra en el notch cerrado, en vez del título" Margin="28,0,0,0" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Reproductor de música (el que abre el botón «Abrir…» y el que se prefiere si suenan varios)" TextWrapping="Wrap" />
                <ComboBox x:Name="PlayerCombo" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Spotify" />
                    <ComboBoxItem Content="Feishin (Navidrome)" />
                    <ComboBoxItem Content="Otro (ruta al .exe)" />
                </ComboBox>
                <TextBox x:Name="PlayerPathBox" PlaceholderText="Ruta del .exe: para «Otro», o si Feishin no está en su carpeta habitual" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Intervalo de sondeo (segundos)" />
                <NumberBox x:Name="PollIntervalBox" Minimum="5" Maximum="600" SpinButtonPlacementMode="Inline" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Carpeta ~/.claude alternativa (opcional)" />
                <TextBox x:Name="ClaudeHomeBox" PlaceholderText="C:\Users\tu-usuario\.claude" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Carpeta ~/.copilot alternativa (opcional)" />
                <TextBox x:Name="CopilotHomeBox" PlaceholderText="C:\Users\tu-usuario\.copilot" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Carpeta de datos de OpenCode alternativa (opcional)" />
                <TextBox x:Name="OpenCodeBox" PlaceholderText="C:\Users\tu-usuario\.local\share\opencode" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Cuentas Codex adicionales (una ruta CODEX_HOME por línea)" />
                <TextBox x:Name="CodexHomesBox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Anthropic Admin API key (opcional, solo para uso de organización)" />
                <PasswordBox x:Name="AnthropicAdminKeyBox" PlaceholderText="sk-ant-admin-..." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Calendario: archivo .ics (opcional)" />
                <TextBox x:Name="CalendarIcsBox" PlaceholderText="C:\Users\tu-usuario\calendario.ics" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Carpeta de descargas a vigilar (opcional, por defecto Descargas)" />
                <TextBox x:Name="DownloadsFolderBox" PlaceholderText="C:\Users\tu-usuario\Downloads" />
            </StackPanel>

            <Button x:Name="SaveButton" Content="Guardar" Click="OnSaveClicked" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Window>
