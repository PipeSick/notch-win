<Window
    x:Class="NotchWin.App.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A very light scrim keeps white text readable over a bright window without hiding the glass (it used to be 30 % black, which turned the glass into plain black). -->
    <Grid x:Name="RootGrid" Background="#1F000000" AllowDrop="True"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
          DragEnter="OnRootDragEnter" DragOver="OnRootDragOver" Drop="OnRootDrop">

        <!-- Collapsed pill: mini cover + title on the left; running timer and equalizer on the right. -->
        <Grid x:Name="CollapsedBar" Height="32" VerticalAlignment="Top" Background="Transparent"
              Padding="14,0" ColumnSpacing="8" Tapped="OnBarTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="MiniArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Background="#1C1C1E" Visibility="Collapsed" />
            <!-- WinMac 2.0: a download in progress, or test media in CI, when there is no track (the track and its lyrics always win: CompactPolicy). -->
            <StackPanel x:Name="MiniActivity" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon x:Name="MiniActivityIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12" Foreground="#0A84FF" VerticalAlignment="Center" />
                <TextBlock x:Name="MiniActivityText" Foreground="White" FontSize="12" FontWeight="SemiBold" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="MiniActivitySub" Foreground="#98989D" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MiniTitle" Grid.Column="1" Foreground="White" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="190"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" Foreground="#FFD60A" FontSize="12" VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <StackPanel x:Name="EqPanel" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                            Height="16" Visibility="Collapsed">
                    <Rectangle x:Name="Eq0" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                    <Rectangle x:Name="Eq1" Width="3" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                    <Rectangle x:Name="Eq2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                    <Rectangle x:Name="Eq3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Brief banner shown in the collapsed pill: new track, finished agent task, timer, download. -->
        <Grid x:Name="ToastBar" Height="32" VerticalAlignment="Top" Padding="14,0" ColumnSpacing="8"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ToastArt" Width="20" Height="20" CornerRadius="6" Background="#1C1C1E" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="170" />
                <TextBlock x:Name="ToastArtist" Foreground="#98989D" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="100" />
            </StackPanel>
        </Grid>

        <!-- Volume / brightness indicator (macOS style): symbol, compact level bar and percentage. Shown for a moment by the pill arbiter. -->
        <Grid x:Name="HudBar" Height="32" VerticalAlignment="Top" Padding="16,0" ColumnSpacing="10"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="HudIcon" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="14" Foreground="White" VerticalAlignment="Center" />
            <Border x:Name="HudTrack" Grid.Column="1" Height="5" CornerRadius="2.5" Background="#38FFFFFF" VerticalAlignment="Center">
                <Border x:Name="HudFill" HorizontalAlignment="Left" CornerRadius="2.5" Background="White" Width="0" />
            </Border>
            <TextBlock x:Name="HudText" Grid.Column="2" Foreground="White" FontSize="12" FontWeight="SemiBold" MinWidth="34"
                       TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- A Windows notification relayed by WinMac: app icon, title and a one-line summary. The pill grows for a few seconds and goes back. -->
        <Grid x:Name="NotifBar" Height="52" VerticalAlignment="Top" Padding="14,0,16,0" ColumnSpacing="10"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="28" Height="28" VerticalAlignment="Center">
                <Border x:Name="NotifInitialBack" CornerRadius="7" Background="#3A3A3C">
                    <TextBlock x:Name="NotifInitial" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image x:Name="NotifIcon" Width="28" Height="28" Stretch="Uniform" Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="NotifTitle" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="NotifBody" Foreground="#B4B4BA" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>

        <!-- Expanded island. Fixed 440 DIP wide and centered, so the growing window reveals it symmetrically. -->
        <StackPanel x:Name="ExpandedPanel" Width="520" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Padding="22,6,22,20" Spacing="12" Visibility="Collapsed">

            <Grid x:Name="HeaderBar" Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" Tapped="OnBarTapped">
                    <TextBlock x:Name="SourceText" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Click="OnGearClicked" Background="Transparent" BorderThickness="0" Padding="0" Width="26" Height="26"
                            CornerRadius="8" ToolTipService.ToolTip="Personalizar secciones">
                        <FontIcon x:Name="GearIcon" Glyph="&#xE713;" FontSize="13" Foreground="#8E8E93" />
                    </Button>
                    <Button x:Name="CollapseButton" Click="OnCollapseClicked" Background="Transparent" BorderThickness="0" Padding="0" Width="26" Height="26"
                            CornerRadius="8" ToolTipService.ToolTip="Cerrar">
                        <FontIcon Glyph="&#xE70E;" FontSize="10" Foreground="#8E8E93" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- WinMac 2.0: media header (cover, title, artist, current synced-lyric line, progress, controls only if real). Hidden without media. -->
            <Grid x:Name="NowHeader" ColumnSpacing="14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="NowArt" Width="64" Height="64" CornerRadius="12" Background="#2C2C2E">
                    <FontIcon x:Name="NowArtGlyph" Glyph="&#xE8D6;" FontSize="22" Foreground="#8E8E93" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="NowTitle" Foreground="White" FontSize="15" FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="NowTestTag" Background="#33FF9F0A" CornerRadius="5" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Datos de prueba" Foreground="#FFB340" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="NowArtist" Foreground="#98989D" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowLyric" Foreground="#E5E5EA" FontSize="12" FontStyle="Italic" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <Grid x:Name="NowProgressRow" ColumnSpacing="8" Margin="0,4,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NowElapsed" Foreground="#98989D" FontSize="10.5" VerticalAlignment="Center" />
                        <Border x:Name="NowTrack" Grid.Column="1" Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center">
                            <Border x:Name="NowFill" HorizontalAlignment="Left" CornerRadius="2" Background="White" Width="0" />
                        </Border>
                        <TextBlock x:Name="NowTotal" Grid.Column="2" Foreground="#98989D" FontSize="10.5" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="NowControls" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed">
                    <Button x:Name="NowPrevButton" Click="OnNowPrev" Background="Transparent" BorderThickness="0" Width="34" Height="34" CornerRadius="17" ToolTipService.ToolTip="Anterior">
                        <Viewbox Width="13" Height="13"><Path Data="M2.5,2.5 L4.3,2.5 L4.3,13.5 L2.5,13.5 Z M14,2.5 L5.5,8 L14,13.5 Z" Fill="White" /></Viewbox>
                    </Button>
                    <Button Click="OnNowPlayPause" Background="Transparent" BorderThickness="0" Width="38" Height="38" CornerRadius="19" ToolTipService.ToolTip="Reproducir o pausar">
                        <Grid><Viewbox x:Name="NowPlayIcon" Width="16" Height="16"><Path Data="M4,2.5 L13.5,8 L4,13.5 Z" Fill="White" /></Viewbox><Viewbox x:Name="NowPauseIcon" Width="16" Height="16" Visibility="Collapsed"><Path Data="M3.5,2.5 L6.5,2.5 L6.5,13.5 L3.5,13.5 Z M9.5,2.5 L12.5,2.5 L12.5,13.5 L9.5,13.5 Z" Fill="White" /></Viewbox></Grid>
                    </Button>
                    <Button x:Name="NowNextButton" Click="OnNowNext" Background="Transparent" BorderThickness="0" Width="34" Height="34" CornerRadius="17" ToolTipService.ToolTip="Siguiente">
                        <Viewbox Width="13" Height="13"><Path Data="M13.5,2.5 L11.7,2.5 L11.7,13.5 L13.5,13.5 Z M2,2.5 L10.5,8 L2,13.5 Z" Fill="White" /></Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="TabBar" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="3" ColumnSpacing="2" />

            <Grid x:Name="PaneHost" MinHeight="168">

                <!-- Music -->
                <StackPanel x:Name="MusicPane" Spacing="12" VerticalAlignment="Top">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top: cover, title and artist, and the music wave on the right. -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ArtBorder" Width="64" Height="64" CornerRadius="14" Background="#1C1C1E" VerticalAlignment="Center">
                            <FontIcon x:Name="ArtPlaceholder" Glyph="&#xE8D6;" FontSize="26" Foreground="#48484A" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" Text="Nada en reproducción" />
                            <TextBlock x:Name="ArtistText" Foreground="#98989D" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Button x:Name="OpenPlayerButton" Click="OnOpenPlayerClicked" Content="Abrir Spotify"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="14,5" CornerRadius="14"
                                    Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel x:Name="MusicEq" Grid.Column="2" Orientation="Horizontal" Spacing="3" Height="28"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle x:Name="XEq0" Width="4" Height="8" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="XEq1" Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="XEq2" Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" />
                            <Rectangle x:Name="XEq3" Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProgressRow" Grid.Row="1" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center" Text="0:00" />
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProgressDone" Width="0*" />
                                <ColumnDefinition x:Name="ProgressRest" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="#3A3A3C" CornerRadius="2" />
                            <Border Background="White" CornerRadius="2" />
                        </Grid>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="#8E8E93" FontSize="10"
                                   VerticalAlignment="Center" Text="0:00" />
                    </Grid>

                    <StackPanel x:Name="ControlsRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="22"
                                Visibility="Collapsed">
                        <Button Click="OnPreviousClicked" Background="Transparent" BorderThickness="0" Padding="10" CornerRadius="20">
                            <Viewbox Width="16" Height="16"><Path Data="M2.5,2.5 L4.3,2.5 L4.3,13.5 L2.5,13.5 Z M14,2.5 L5.5,8 L14,13.5 Z" Fill="White" /></Viewbox>
                        </Button>
                        <Button Click="OnPlayPauseClicked" Background="White" BorderThickness="0" Padding="0"
                                Width="44" Height="44" CornerRadius="22">
                            <Grid><Viewbox x:Name="PlayIcon" Width="18" Height="18"><Path Data="M4,2.5 L13.5,8 L4,13.5 Z" Fill="Black" /></Viewbox><Viewbox x:Name="PauseIcon" Width="18" Height="18" Visibility="Collapsed"><Path Data="M3.5,2.5 L6.5,2.5 L6.5,13.5 L3.5,13.5 Z M9.5,2.5 L12.5,2.5 L12.5,13.5 L9.5,13.5 Z" Fill="Black" /></Viewbox></Grid>
                        </Button>
                        <Button Click="OnNextClicked" Background="Transparent" BorderThickness="0" Padding="10" CornerRadius="20">
                            <Viewbox Width="16" Height="16"><Path Data="M13.5,2.5 L11.7,2.5 L11.7,13.5 L13.5,13.5 Z M2,2.5 L10.5,8 L2,13.5 Z" Fill="White" /></Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Synced lyrics (opt-in in Settings) -->
                <StackPanel x:Name="LyricsBox" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,10" Spacing="4"
                            Visibility="Collapsed">
                    <TextBlock x:Name="LyricPrev" Foreground="#5A5A5E" FontSize="12" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="LyricCur" Foreground="White" FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock x:Name="LyricNext" Foreground="#5A5A5E" FontSize="12" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>
                </StackPanel>

                <!-- AI agents -->
                <StackPanel x:Name="AgentsPane" Spacing="10" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock x:Name="AgentsPeriod" Text="Hoy" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="AgentsEmpty" Foreground="#636366" FontSize="12" HorizontalAlignment="Center" Margin="0,38,0,0"
                               Text="Todavía no hay actividad de agentes hoy" />
                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="AgentsList" Spacing="10" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Timer -->
                <StackPanel x:Name="TimerPane" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="112" Height="112" HorizontalAlignment="Center">
                        <ProgressRing x:Name="TimerRing" Width="112" Height="112" IsIndeterminate="False" Minimum="0" Maximum="100"
                                      Value="100" Foreground="#FFD60A" Background="#3A3A3C" />
                        <TextBlock x:Name="TimerBig" Foreground="White" FontSize="26" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="25:00" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="5 min" Tag="5" Click="OnPresetClicked" CornerRadius="14" Padding="12,5" />
                        <Button Content="15 min" Tag="15" Click="OnPresetClicked" CornerRadius="14" Padding="12,5" />
                        <Button Content="25 min" Tag="25" Click="OnPresetClicked" CornerRadius="14" Padding="12,5" />
                        <Button Content="50 min" Tag="50" Click="OnPresetClicked" CornerRadius="14" Padding="12,5" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button x:Name="TimerStartButton" Content="Iniciar" Click="OnTimerStartClicked" Background="#FFD60A"
                                Foreground="Black" CornerRadius="14" Padding="18,5" />
                        <Button Content="Reiniciar" Click="OnTimerResetClicked" CornerRadius="14" Padding="14,5" />
                    </StackPanel>
                </StackPanel>

                <!-- Calendar -->
                <StackPanel x:Name="CalendarPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock x:Name="CalendarHeader" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                    <TextBlock x:Name="CalendarEmpty" Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,34,0,0" />
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="CalendarList" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Downloads -->
                <StackPanel x:Name="DownloadsPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock Text="DESCARGAS" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                    <TextBlock x:Name="DownloadsEmpty" Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,38,0,0" Text="Sin descargas en curso" />
                    <StackPanel x:Name="DownloadsList" Spacing="8" />
                </StackPanel>

                <!-- Notifications -->
                <StackPanel x:Name="NotificationsPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="NOTIFICACIONES" Foreground="#636366" FontSize="10" FontWeight="SemiBold"
                                   CharacterSpacing="80" VerticalAlignment="Center" />
                        <Button Content="Limpiar" Click="OnClearNotificationsClicked" HorizontalAlignment="Right"
                                CornerRadius="12" Padding="10,3" FontSize="11" />
                    </Grid>
                    <TextBlock x:Name="NotificationsEmpty" Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                               Margin="0,38,0,0" Text="Sin notificaciones" />
                    <ScrollViewer MaxHeight="184" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="NotificationsList" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Shelf: drop files in, drag them back out into another app -->
                <StackPanel x:Name="ShelfPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock Text="ESTANTERÍA" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                    <Grid MinHeight="124">
                        <Rectangle RadiusX="14" RadiusY="14" Stroke="#3A3A3C" StrokeThickness="1.5" StrokeDashArray="4 3" />
                        <TextBlock x:Name="ShelfHint" Foreground="#636366" FontSize="11" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                                   Text="Suelta archivos aquí, o arrástralos hacia el notch desde cualquier app" />
                        <ScrollViewer MaxHeight="150" Margin="8" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="ShelfList" Spacing="6" />
                        </ScrollViewer>
                    </Grid>
                </StackPanel>

                <!-- Camera mirror -->
                <StackPanel x:Name="CameraPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <Border Height="150" CornerRadius="14" Background="#151B26">
                        <Grid>
                            <MediaPlayerElement x:Name="CameraView" Stretch="UniformToFill" AreTransportControlsEnabled="False"
                                                RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <MediaPlayerElement.RenderTransform>
                                    <ScaleTransform x:Name="CameraMirror" ScaleX="-1" />
                                </MediaPlayerElement.RenderTransform>
                            </MediaPlayerElement>
                            <TextBlock x:Name="CameraStatus" Foreground="#8E8E93" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                                       Text="Abriendo la cámara…" />
                        </Grid>
                    </Border>
                    <ToggleButton x:Name="MirrorButton" Content="Espejo" IsChecked="True" HorizontalAlignment="Center"
                                  Click="OnMirrorClicked" CornerRadius="14" Padding="14,5" />
                </StackPanel>

                <!-- System resources -->
                <StackPanel x:Name="SystemPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid x:Name="SystemGrid" RowSpacing="8" ColumnSpacing="8" />
                </StackPanel>

                <!-- Clipboard history -->
                <StackPanel x:Name="ClipboardPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClipSearch" PlaceholderText="Buscar en el portapapeles" TextChanged="OnClipSearchChanged"
                                 CornerRadius="10" />
                        <Button Grid.Column="1" Click="OnClipClearClicked" Background="Transparent" BorderThickness="0"
                                Padding="0" Width="32" Height="32" CornerRadius="10"
                                ToolTipService.ToolTip="Borrar todo (menos lo fijado)">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#8E8E93" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ClipboardEmpty" Foreground="#636366" FontSize="12" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,30,0,0"
                               Text="Aquí aparecerá lo que copies mientras NotchWin esté abierto" />
                    <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="ClipboardList" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>

                <!-- WinMac 2.0 · En curso: every activity in progress (media, downloads…), with real actions only -->
                <StackPanel x:Name="ActivityPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock x:Name="ActivityEmpty" Foreground="#8E8E93" FontSize="12.5" TextWrapping="Wrap" Margin="0,24,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="No hay nada en curso. Aquí verás la música, las descargas y las capturas recientes." />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="ActivityList" Spacing="6" />
                    </ScrollViewer>
                </StackPanel>

                <!-- WinMac 2.0 · Capturas: gallery of the screenshots folder (thumbnails decoded small), actions on the selected one -->
                <StackPanel x:Name="CapturesPane" Spacing="10" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock x:Name="CapturesEmpty" Foreground="#8E8E93" FontSize="12.5" TextWrapping="Wrap" Margin="0,24,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="Todavía no hay capturas. Las de Windows (Win+Impr Pant) aparecerán aquí." />
                    <Grid>
                        <TextBlock Text="RECIENTES" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" VerticalAlignment="Center" />
                        <Button x:Name="CapturesAll" Click="OnCapturesAll" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Background="#1FFFFFFF" BorderThickness="0" CornerRadius="6" Content="Ver todas" ToolTipService.ToolTip="Abrir la galería completa: buscar, ordenar, renombrar, editar" />
                    </Grid>
                    <VariableSizedWrapGrid x:Name="CapturesGrid" Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="158" ItemHeight="118" HorizontalAlignment="Center" />
                    <StackPanel x:Name="CaptureActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>

                <!-- WinMac 2.0 · Historial: finished activities of this session -->
                <StackPanel x:Name="HistoryPane" Spacing="8" Visibility="Collapsed" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="RECIENTES" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" VerticalAlignment="Center" />
                        <Button x:Name="HistoryClear" Click="OnHistoryClear" HorizontalAlignment="Right" Padding="8,2" FontSize="11" Background="#1FFFFFFF" BorderThickness="0" CornerRadius="6" Content="Borrar historial" />
                    </Grid>
                    <TextBlock x:Name="HistoryEmpty" Foreground="#8E8E93" FontSize="12.5" TextWrapping="Wrap" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="El historial está vacío. Las descargas y capturas terminadas quedan aquí durante la sesión." />
                    <ScrollViewer MaxHeight="290" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="HistoryList" Spacing="6" />
                    </ScrollViewer>
                </StackPanel>

                <!-- Customize sections -->
                <StackPanel x:Name="CustomizePane" Spacing="6" Visibility="Collapsed" VerticalAlignment="Top">
                    <TextBlock Text="CRISTAL" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                    <Slider x:Name="GlassSlider" Minimum="0" Maximum="100" StepFrequency="5" />
                    <TextBlock Text="SECCIONES" Foreground="#636366" FontSize="10" FontWeight="SemiBold" CharacterSpacing="80" />
                    <StackPanel x:Name="CustomizeList" Spacing="6" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Glass finish: soft highlight at the top and a thin light rim, drawn above the content but never hit-tested. -->
        <Rectangle x:Name="GlassHighlight" Height="46" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#2BFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Inside WinMac and collapsed, the notch takes the top bar's look: a soft shade along its lower edge is all that tells it apart (see UpdateSurface). -->
        <Rectangle x:Name="BarShade" Height="5" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#33000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border x:Name="GlassRim" CornerRadius="0,0,20,20" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#80FFFFFF" Offset="0" />
                    <GradientStop Color="#1AFFFFFF" Offset="0.22" />
                    <GradientStop Color="#0FFFFFFF" Offset="0.6" />
                    <GradientStop Color="#3DFFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
    </Grid>
</Window>
