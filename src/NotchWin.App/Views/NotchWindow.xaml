<Window
    x:Class="NotchWin.App.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="Black"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited">

        <!-- Collapsed pill: mini cover on the left, equalizer on the right (only while playing). -->
        <Grid x:Name="CollapsedBar" Height="32" VerticalAlignment="Top" Background="Transparent"
              Padding="14,0" ColumnSpacing="8" Tapped="OnBarTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="MiniArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Background="#1C1C1E" Visibility="Collapsed" />
            <TextBlock x:Name="MiniTitle" Grid.Column="1" Foreground="White" FontSize="12" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            <StackPanel x:Name="EqPanel" Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Height="16" Visibility="Collapsed">
                <Rectangle x:Name="Eq0" Width="3" Height="5" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                <Rectangle x:Name="Eq1" Width="3" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                <Rectangle x:Name="Eq2" Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
                <Rectangle x:Name="Eq3" Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Brief "now playing" banner shown in the collapsed pill when the track changes. -->
        <Grid x:Name="ToastBar" Height="32" VerticalAlignment="Top" Padding="14,0" ColumnSpacing="8"
              Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="ToastArt" Width="20" Height="20" CornerRadius="6" Background="#1C1C1E" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="150" />
                <TextBlock x:Name="ToastArtist" Foreground="#98989D" FontSize="12"
                           TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="100" />
            </StackPanel>
        </Grid>

        <!-- Expanded island. Fixed 440 DIP wide and centered, so the growing window reveals it symmetrically. -->
        <StackPanel x:Name="ExpandedPanel" Width="440" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Padding="24,6,24,20" Spacing="14" Visibility="Collapsed">

            <Grid x:Name="HeaderBar" Height="26" Background="Transparent" Tapped="OnBarTapped">
                <TextBlock x:Name="SourceText" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70E;" FontSize="10" Foreground="#636366" HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ArtBorder" Width="92" Height="92" CornerRadius="16" Background="#1C1C1E">
                    <FontIcon x:Name="ArtPlaceholder" Glyph="&#xE8D6;" FontSize="32" Foreground="#48484A" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Text="Nada en reproducción" />
                    <TextBlock x:Name="ArtistText" Foreground="#98989D" FontSize="13"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />

                    <Grid x:Name="ProgressRow" Margin="0,8,0,0" ColumnSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Foreground="#8E8E93" FontSize="10" VerticalAlignment="Center" Text="0:00" />
                        <Grid Grid.Column="1" Height="4" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ProgressDone" Width="0*" />
                                <ColumnDefinition x:Name="ProgressRest" Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="#3A3A3C" CornerRadius="2" />
                            <Border Background="White" CornerRadius="2" />
                        </Grid>
                        <TextBlock x:Name="DurationText" Grid.Column="2" Foreground="#8E8E93" FontSize="10"
                                   VerticalAlignment="Center" Text="0:00" />
                    </Grid>

                    <StackPanel x:Name="ControlsRow" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14"
                                Margin="0,4,0,0" Visibility="Collapsed">
                        <Button Click="OnPreviousClicked" Background="Transparent" BorderThickness="0" Padding="10" CornerRadius="20">
                            <FontIcon Glyph="&#xE892;" FontSize="16" Foreground="White" />
                        </Button>
                        <Button Click="OnPlayPauseClicked" Background="White" BorderThickness="0" Padding="0"
                                Width="40" Height="40" CornerRadius="20">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" Foreground="Black" />
                        </Button>
                        <Button Click="OnNextClicked" Background="Transparent" BorderThickness="0" Padding="10" CornerRadius="20">
                            <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="White" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="AgentsSection" Spacing="10" Visibility="Collapsed">
                <Rectangle Height="1" Fill="#2C2C2E" />
                <TextBlock Text="AGENTES DE IA" Foreground="#636366" FontSize="10" FontWeight="SemiBold"
                           CharacterSpacing="80" />
                <StackPanel x:Name="AgentsList" Spacing="12" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
