<Window
    x:Class="NotchWin.App.Views.NotchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="RootGrid" Background="Black" CornerRadius="0,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CollapsedBar" Grid.Row="0" Tapped="OnBarTapped" Background="Transparent">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock x:Name="CollapsedTrackText" Text="NotchWin" Foreground="White" FontSize="12" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="ExpandedPanel" Grid.Row="1" Padding="16" Spacing="12" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image x:Name="AlbumArtImage" Width="56" Height="56" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Foreground="White" FontWeight="SemiBold" Text="Sin reproducción" />
                    <TextBlock x:Name="ArtistText" Foreground="#CCCCCC" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <ItemsControl x:Name="AgentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="White" FontSize="12"
                                       Text="{Binding Kind}" />
                            <TextBlock Grid.Column="1" Foreground="#AAAAAA" FontSize="12"
                                       Text="{Binding TokensToday.Total}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
